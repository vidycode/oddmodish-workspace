# Public application URL; never place secrets in NEXT_PUBLIC_ variables.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Project Settings → API. The publishable key is safe for browser use
# because authorization is enforced by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Configure in Netlify; never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Future integrations. Keep disabled until their scopes and audit behavior are reviewed.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
OPENAI_API_KEY=
